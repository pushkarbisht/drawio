        <mxCell id="CeNj4uSWV4GNdDWi5vfT-21" value="The final docx file will be saved to the folder /&lt;span style=&quot;background-color: rgb(255, 255, 0);&quot;&gt;final_docx&lt;/span&gt;" style="whiteSpace=wrap;html=1;rounded=0;" vertex="1" parent="CeNj4uSWV4GNdDWi5vfT-28">
